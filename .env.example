# =============================================================================
# ENTERPRISE E-COMMERCE PLATFORM — LOCAL ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to '.env' in the project root and replace all <CHANGE_ME_*>
# placeholders with your local development passwords before running Docker Compose.
# NEVER commit the actual '.env' file to Git!
# =============================================================================

# --- PostgreSQL Superuser (Used only by container init script) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=<CHANGE_ME_POSTGRES_SUPERUSER_PASSWORD>
POSTGRES_PORT=5432

# --- Isolated Database-per-Service Credentials ---
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak_db_user
KEYCLOAK_DB_PASSWORD=<CHANGE_ME_KEYCLOAK_DB_PASSWORD>

USER_DB_NAME=user_db
USER_DB_USER=user_svc_user
USER_DB_PASSWORD=<CHANGE_ME_USER_DB_PASSWORD>

CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_svc_user
CATALOG_DB_PASSWORD=<CHANGE_ME_CATALOG_DB_PASSWORD>

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_svc_user
INVENTORY_DB_PASSWORD=<CHANGE_ME_INVENTORY_DB_PASSWORD>

COUPON_DB_NAME=coupon_db
COUPON_DB_USER=coupon_svc_user
COUPON_DB_PASSWORD=<CHANGE_ME_COUPON_DB_PASSWORD>

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_svc_user
ORDER_DB_PASSWORD=<CHANGE_ME_ORDER_DB_PASSWORD>

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_svc_user
PAYMENT_DB_PASSWORD=<CHANGE_ME_PAYMENT_DB_PASSWORD>

# --- Redis 7 Cache & Distributed Rate Limiter ---
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_REDIS_PASSWORD>

# --- Keycloak 26 OAuth2 / OIDC Identity Provider ---
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD>
